{
  "expo": {
    "name": "Revvo",
    "slug": "studymind-ai",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1225"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suftnet.revvo",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Revvo uses your camera to scan documents and questions.",
        "NSMicrophoneUsageDescription": "Revvo uses your microphone for voice input in the AI tutor.",
        "NSPhotoLibraryUsageDescription": "Revvo accesses your photo library to scan documents and questions."
      },
      "appleTeamId": "ZQADUF26X5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1225"
      },
      "package": "com.suftnet.studymind",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Revvo uses your photo library to upload study documents.",
          "cameraPermission": "Revvo uses the camera to capture document pages."
        }
      ],
      "expo-font",
      "./plugins/withFmtXcode26Fix"
    ],
    "scheme": "studymind",
    "experiments": {
      "typedRoutes": true
    }
  }
}